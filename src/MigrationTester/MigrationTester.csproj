<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MigrationTester</RootNamespace>
    <AssemblyName>MigrationTester</AssemblyName>
    <IsPackable>true</IsPackable>
    <Description>Tests EF Core migrations against SQL Server with data that is valid before each migration but that its Up() may not handle (duplicates, orphan foreign keys, NULLs, over-long or unconvertible values), and reports which change broke with a T-SQL repair hint.</Description>
    <PackageTags>efcore;entity-framework;migrations;testing;sqlserver;integration-testing</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MigrationTester.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

</Project>
