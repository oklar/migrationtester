<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MigrationRepair</RootNamespace>
    <AssemblyName>MigrationRepair</AssemblyName>
    <IsPackable>true</IsPackable>
    <Description>Adversarial EF Core migration testing for SQL Server: seed pre-migration data that targets schema-tightening operations and run Up() with actionable T-SQL repair hints.</Description>
    <PackageTags>efcore;entity-framework;migrations;testing;adversarial;sqlserver</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MigrationRepair.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

</Project>
