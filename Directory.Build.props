<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Only the library opts back in. -->
    <IsPackable>false</IsPackable>
    <VersionPrefix>0.1.0</VersionPrefix>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
    <!-- Deterministic paths in CI builds, so SourceLink maps them to the repository. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- NuGet metadata; only used by packable projects. -->
  <PropertyGroup>
    <Authors>Larsenq</Authors>
    <Copyright>Copyright (c) 2026 Larsenq</Copyright>
    <PackageProjectUrl>https://github.com/oklar/migrationtester</PackageProjectUrl>
    <RepositoryUrl>https://github.com/oklar/migrationtester</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
